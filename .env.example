# Copy this file to .env.local and fill in your values
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Optional: Google Doc ID for SEO headline guidelines
# Your SEO team edits a Google Doc, and Lighthouse pulls in those guidelines
# to shape the headline generation. To set this up:
# 1. Create a Google Doc with your SEO headline rules
# 2. File > Share > Publish to web (as plain text)
# 3. Copy the doc ID from the URL (the long string between /d/ and /edit)
# SEO_GUIDELINES_DOC_ID=1ABC123def456...
